@model List<RehearsalRoom>
@{
    ViewData["Title"] = "Rehearsal rooms";
}

<section class="hero">
    <h1>Rehearsal rooms</h1>
    <p>Book a room for scene work, monologues or a full run-through.</p>
</section>

<div class="room-grid">
    @foreach (var room in Model)
    {
        <a class="room-card" asp-controller="Home" asp-action="Room" asp-route-id="@room.Id">
            <h2>@room.Name</h2>
            <p class="room-meta">Up to @room.Capacity people</p>
            <span class="tag @(room.HasPiano ? "tag-piano" : "tag-plain")">@(room.HasPiano ? "Piano" : "No piano")</span>
        </a>
    }
</div>
