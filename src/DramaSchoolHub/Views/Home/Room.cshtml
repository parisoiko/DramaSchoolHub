@model RoomDetails
@{
    ViewData["Title"] = Model.Room.Name;
}

<p><a class="back-link" asp-controller="Home" asp-action="Index">← All rooms</a></p>

<article class="panel">
    <h1>@Model.Room.Name</h1>
    <dl class="facts">
        <dt>Capacity</dt>
        <dd>@Model.Room.Capacity people</dd>
        <dt>Piano</dt>
        <dd>@(Model.Room.HasPiano ? "Yes" : "No")</dd>
        <dt>Longest booking</dt>
        <dd>@Model.MaxBookingHours hours</dd>
    </dl>
</article>
