@model List<LifetimeRow>
@{
    ViewData["Title"] = "DI lifetimes";
}

<section class="hero">
    <h1>Service lifetimes</h1>
    <p>
        The controller asks the DI container for each kind of stage pass <strong>twice</strong>.
        Every pass gets a random code when it's created, so the same code means the same object.
        Refresh the page and watch which codes change.
    </p>
</section>

<table>
    <thead>
        <tr><th>Lifetime</th><th>First pass</th><th>Second pass</th><th>Same object?</th></tr>
    </thead>
    <tbody>
        @foreach (var row in Model)
        {
            bool same = row.First == row.Second;
            <tr data-lifetime="@row.Lifetime" data-first="@row.First" data-second="@row.Second">
                <td>@row.Lifetime</td>
                <td><code>@row.First</code></td>
                <td><code>@row.Second</code></td>
                <td><span class="badge @(same ? "same" : "different")">@(same ? "same" : "different")</span></td>
            </tr>
        }
    </tbody>
</table>

<p class="note">
    <strong>The usher</strong>, a separate scoped service, says: <em>“@ViewData["UsherGreeting"]”</em>
    It's the same code as the Scoped row: within one request, every service shares the scoped pass.
</p>

<dl class="legend">
    <dt>Transient</dt><dd>a new object every time one is asked for</dd>
    <dt>Scoped</dt><dd>one object per request</dd>
    <dt>Singleton</dt><dd>one object for the whole app, shared by every request</dd>
</dl>
