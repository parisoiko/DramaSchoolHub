{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Run DramaSchoolHub (http://localhost:5090)",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build DramaSchoolHub",
            "program": "${workspaceFolder}/src/DramaSchoolHub/bin/Debug/net10.0/DramaSchoolHub.dll",
            "cwd": "${workspaceFolder}/src/DramaSchoolHub",
            "console": "integratedTerminal",
            "env": {
                "ASPNETCORE_ENVIRONMENT": "Development",
                "ASPNETCORE_URLS": "http://localhost:5090"
            },
            "serverReadyAction": {
                "action": "openExternally",
                "pattern": "Now listening on:\\s+(https?://\\S+)",
                "uriFormat": "%s"
            }
        }
    ]
}
